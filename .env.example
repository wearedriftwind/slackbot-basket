# Kopiera till .env (lokalt) eller lägg in som variabler i Railway.
# Checka aldrig in riktiga värden. Bara de tre första är obligatoriska.

# Bot User OAuth Token (OAuth & Permissions)
SLACK_BOT_TOKEN=xoxb-...
# App-Level Token med scope connections:write (Basic Information)
SLACK_APP_TOKEN=xapp-...
# Kanal-ID för påminnelser, bokningsnotiser och synk-diffar (kanalinfo → längst ned)
BILJETT_KANAL=C0123456789

# Slack-ID:n (kommaseparerade) som får ändra schema manuellt, radera, exportera och tvinga synk
ADMINS=
# Bara medlemmar i BILJETT_KANAL får boka (true/false)
KRAV_KANALMEDLEMSKAP=true

# Påminnelser: dagar_före@HH:MM, kommaseparerat. Ex: 3@09:00,0@10:00
PAMINNELSER=0@10:00
# Avbokning inom så många dagar före match ger en "biljett ledig"-post
AVBOKNING_NOTIS_DAGAR=7

# Schemakälla och synk
SCHEMA_URL=https://luleabasket.com/matcher/
HEMMALAG=Luleå Basket
ARENA=Luleå Energi Arena
# Klockslag för daglig synk, HH:MM kommaseparerat
SYNK_TIDER=06:30
# Avbryt synken om antalet hemmamatcher minskar mer än så (andel)
SYNK_MAX_MINSKNING=0.3
# Avbryt synken om fler nya matcher än så dyker upp på en gång
SYNK_MAX_NYA=8
# Antal synkar i rad en match får saknas på sidan innan den blir inställd
SYNK_SAKNAD_GRANS=2
# Status spelad sätts så här många timmar efter uppkast
SPELAD_EFTER_TIMMAR=3

TIDSZON=Europe/Stockholm
# Lokalt: data/biljetter.db. I containern sätts /data/biljetter.db (volym) av Dockerfile.
DATABAS_SOKVAG=data/biljetter.db
CSV_IMPORT_SOKVAG=docs/lulea_basket_hemmamatcher_2026-27.csv
LOGGNIVA=INFO
